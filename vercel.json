{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/en", "destination": "/", "permanent": false },
    { "source": "/en/:path*", "destination": "/:path*", "permanent": false },
    { "source": "/fr", "destination": "/", "permanent": false },
    { "source": "/fr/:path*", "destination": "/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/work/:slug", "destination": "/work" }
  ],
  "headers": [
    {
      "source": "/(.*)\.wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    },
    {
      "source": "/(.*)\.glb",
      "headers": [{ "key": "Content-Type", "value": "model/gltf-binary" }]
    },
    {
      "source": "/(_nuxt|webgl|audio|fonts|images)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
